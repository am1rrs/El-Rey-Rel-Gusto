rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user is an admin iff their Firebase UID has a document in admins/{uid}.
    // Creating that document is a manual console step (writes from the console
    // and the Admin SDK bypass these rules).
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validStatus(v) {
      // NOTE: 'cancelled' (double-L) — must match the value the admin dashboard
      // and the checkout flow actually write.
      return v in ['pending', 'preparing', 'ready', 'delivered', 'cancelled'];
    }

    match /orders/{orderId} {
      // Customers place orders WITHOUT authentication. Validate the payload so
      // only well-formed orders can be created.
      // Deliberately NOT validating customer.address / tableNumber / pickupTime
      // / paymentStatus: the checkout writes null for these when they don't
      // apply, and `null is string` is false — tightening here would reject
      // valid orders. Do not tighten without re-testing all three order types.
      allow create: if request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0
        && request.resource.data.timestamp is number
        && validStatus(request.resource.data.status)
        && request.resource.data.orderType in ['dine-in', 'takeaway', 'delivery']
        && request.resource.data.customer is map
        && request.resource.data.customer.name is string
        && request.resource.data.customer.phone is string
        && request.resource.data.items is list
        && request.resource.data.subtotal is number
        && request.resource.data.deliveryFee is number
        && request.resource.data.total is number;

      // Reads and status updates are admin-only.
      allow read, update: if isAdmin();

      // No delete rule => delete is denied for everyone.
    }

    match /admins/{uid} {
      // A user may read only their own admin record.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      // The admin list is managed from the console / Admin SDK only.
      allow create, update, delete: if false;
    }
  }
}
